{
  "manifest_version": 3,
  "name": "抖音聊天导出助手",
  "description": "单会话 IM API 历史与原生语音转写候选版，保留已验证的网页滚动导出回退。",
  "version": "0.4.1",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "抖音聊天导出助手",
    "default_popup": "popup.html"
  }
}
